# Look the engine up on each request (for at most 10s), not once at start-up:
# when it is replaced it comes back at another address. The resolver is the
# container's own (from /etc/resolv.conf: Docker's, or Azure's), but nginx
# doesn't apply its search domains, so in Azure ENGINE_URL is the engine's full
# internal name (engine.internal.<environment domain>).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    root /usr/share/nginx/html;

    # The shared password, if DASHBOARD_PASSWORD is set (see 19-basic-auth.envsh).
    auth_basic ${AUTH_BASIC};
    auth_basic_user_file ${AUTH_BASIC_USER_FILE};

    # For the platform's health probes, which can't sign in.
    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The engine's API, including the /api/stream server-sent events.
    location /api/ {
        # A variable makes nginx resolve the name through the resolver above.
        set $engine ${ENGINE_URL};
        proxy_pass $engine;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The engine's own host name: Azure Container Apps routes by it.
        proxy_set_header Host $proxy_host;
        # Pass each event on as it comes, and keep a quiet stream open.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Hashed build assets never change; index.html must always be fresh.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
