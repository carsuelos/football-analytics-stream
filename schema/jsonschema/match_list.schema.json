{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchList",
  "description": "Matches the simulator can replay (GET /matches).",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/definitions/SchemaVersion" },
    "matches": {
      "type": "array",
      "items": {
        "title": "MatchInfo",
        "description": "A match without its events.",
        "type": "object",
        "properties": {
          "match_id": { "$ref": "common.schema.json#/definitions/MatchId" },
          "competition": { "type": "string" },
          "season": { "type": "string" },
          "stage": { "type": "string" },
          "date": {
            "description": "Kick-off date, YYYY-MM-DD.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "home_team": { "$ref": "common.schema.json#/definitions/Team" },
          "away_team": { "$ref": "common.schema.json#/definitions/Team" },
          "home_score": { "type": "integer", "minimum": 0 },
          "away_score": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "match_id",
          "competition",
          "season",
          "stage",
          "date",
          "home_team",
          "away_team",
          "home_score",
          "away_score"
        ]
      }
    }
  },
  "required": ["schema_version", "matches"]
}
